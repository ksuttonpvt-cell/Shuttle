# Copy this file to ".env" and fill it in. Lines starting with # are ignored.

# Your admin login (only used the very first time the app starts)
ADMIN_EMAIL=you@example.com
ADMIN_NAME=Your Name
ADMIN_PASSWORD=change-me-please

# The web address people will use (used in QR codes and texted links)
PUBLIC_URL=https://shuttle.example.com

# Port the app listens on inside this computer
PORT=3000

# Automatic updates: check GitHub for new versions and install them (1 = on, 0 = off)
AUTO_UPDATE=1
# How often to check, in minutes
UPDATE_CHECK_MINUTES=5

# Automatic customer texts through Twilio (twilio.com). Leave blank to send no texts.
# Turn individual messages on or off in Admin > Settings > Customer texts.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
