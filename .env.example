# Copy this file to ".env" and fill it in. Lines starting with # are ignored.

# Your admin login (only used the very first time the app starts)
ADMIN_EMAIL=you@example.com
ADMIN_NAME=Your Name
ADMIN_PASSWORD=change-me-please

# The web address people will use (used in QR codes and texted links)
PUBLIC_URL=https://shuttle.example.com

# Port the app listens on inside this computer
PORT=3000

# Automatic updates: check GitHub for new versions and install them (1 = on, 0 = off)
AUTO_UPDATE=1
# How often to check, in minutes
UPDATE_CHECK_MINUTES=5

# Shuttle Control (this PC only) runs on this port. Open it with "Shuttle Control.bat".
CONTROL_PORT=3001

# Cloudflare Tunnel, if Shuttle Control runs it (set this from Shuttle Control's Cloudflare card).
# CLOUDFLARE_TUNNEL_TOKEN=
# Connection type: auto, quic, or http2 (try http2 if the connection keeps dropping)
# TUNNEL_PROTOCOL=auto

# Driver route planner: real road driving times from an OSRM server (the free public one by default).
# Email for password reset links. Normally set in Admin > Settings > Email for password resets;
# these win over that page. Microsoft 365: smtp.office365.com, Gmail: smtp.gmail.com (use an app password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Processor cores and memory are normally set in Admin > Server. These win over that page:
# CORES=auto (or a number, e.g. 1 to run a single copy) and RAM_MB= (memory limit in MB).
CORES=
RAM_MB=

# ROUTING=off uses straight-line estimates only. ROUTING_URL can point to your own OSRM server.
ROUTING=
ROUTING_URL=

# Automatic customer texts through Twilio (twilio.com). Leave blank to send no texts.
# Turn individual messages on or off in Admin > Settings > Customer texts.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
